#!/usr/bin/env bash
# gate — the repo's check chain (`.claude/rules/ops.md` Env), each step's rc + wall-clock +
# verdict + the suite's 10 slowest tests; rc 0 only when every step passes. A full or split run
# appends one row per step to the step ledger (`.claude/rules/ops.md` Step ledger) and prints each
# row as a `gate-ledger<TAB>` line, which `.agent/ci-gate` imports from a CI log.
#   .agent/gate                  full gate: static checks + scanners + unittest discover (D28
#                                included) + uv build + spec-lint
#   .agent/gate <tests.module>…  fast gate: static checks + those tests minus D28 (a history
#                                replay) + spec-lint; iteration only, no ledger rows
#   .agent/gate --omit-d28       full gate with the suite minus D28, NAMED as a split run
#                                (`.claude/rules/history-gates.md`); CI's split leg
set -u
cd "$(dirname "$0")/.." || exit 2
case "${1:-}" in
  "") mode="full" ;;
  --omit-d28) mode="split" ;;
  *) mode="fast" ;;
esac
ledger=${CEMENT_GATE_LEDGER:-$(git rev-parse --path-format=absolute --git-common-dir)/cement-gate-ledger.tsv}
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
tree=unknown
if [ "$mode" != fast ]; then
  # The graded tree = the working tree's own tree id (`HEAD^{tree}` when clean), written through
  # a scratch copy of the index so the real one stays untouched.
  index=$(mktemp)
  cp "$(git rev-parse --git-path index)" "$index" 2> /dev/null || rm -f "$index"
  GIT_INDEX_FILE=$index git add -A 2> /dev/null && tree=$(GIT_INDEX_FILE=$index git write-tree)
  rm -f "$index"
fi
names=() rcs=() secs=()
step() { # step <name> <cmd…>
  local name=$1 t0=$EPOCHREALTIME rc
  shift
  printf '== %s: %s\n' "$name" "$*"
  "$@"
  rc=$?
  names+=("$name") rcs+=("$rc") secs+=("$(awk -v a="$t0" -v b="$EPOCHREALTIME" 'BEGIN{printf "%.1f", b - a}')")
}
# `--durations` (Python 3.12+) = the `requires-python` floor, so every `uv run` interpreter has it.
durations=(--durations 10)
step format uv run ruff format --check
step lint uv run ruff check
step types uv run mypy
if [ "${1:-}" = "--omit-d28" ]; then
  shift
  step audit uv audit --locked --preview-features audit-command
  step constraints uv run python .agent/owui-audit --lock examples/command_source/build-constraints.txt --no-holds
  step secrets .agent/gitleaks
  step actions .agent/zizmor
  step shell .agent/shellcheck
  step skips uv run python .agent/skip-census
  step register uv run python .agent/register-audit --gate
  step articles uv run python .agent/article-audit
  step law uv run python .agent/law-census
  step stored-ints uv run python .agent/decisions/p03-stored-int-census.py
  step anchors uv run python .agent/decisions/p76-anchor-census.py --quiet
  step revisions uv run python .agent/decisions/p94-sha-census.py
  step scratch uv run python .agent/decisions/p10-scratch-census.py
  step queue uv run python .agent/decisions/m3-deferred-validate.py
  step reports uv run python .agent/decisions/m3-report-validate.py --all
  step unittest uv run python .agent/suite --omit-d28 "${durations[@]}"
  step build uv build
  step wheels .agent/decisions/p34-two-wheel-smoke.sh
elif [ $# -eq 0 ]; then
  step audit uv audit --locked --preview-features audit-command
  step constraints uv run python .agent/owui-audit --lock examples/command_source/build-constraints.txt --no-holds
  step secrets .agent/gitleaks
  step actions .agent/zizmor
  step shell .agent/shellcheck
  step skips uv run python .agent/skip-census
  step register uv run python .agent/register-audit --gate
  step articles uv run python .agent/article-audit
  step law uv run python .agent/law-census
  step stored-ints uv run python .agent/decisions/p03-stored-int-census.py
  step anchors uv run python .agent/decisions/p76-anchor-census.py --quiet
  step revisions uv run python .agent/decisions/p94-sha-census.py
  step scratch uv run python .agent/decisions/p10-scratch-census.py
  step queue uv run python .agent/decisions/m3-deferred-validate.py
  step reports uv run python .agent/decisions/m3-report-validate.py --all
  step unittest uv run python -m unittest discover -s tests -t . "${durations[@]}"
  step build uv build
  step wheels .agent/decisions/p34-two-wheel-smoke.sh
else
  step unittest uv run python .agent/suite --omit-d28 "${durations[@]}" "$@"
fi
step spec-lint .agent/spec-lint
printf '\n%-10s %4s %9s  %s\n' step rc seconds verdict
fail=0 rows=()
for i in "${!names[@]}"; do
  verdict=green class=-
  [ "${rcs[$i]}" -eq 0 ] || verdict=red class=unclassified fail=1
  printf '%-10s %4s %9s  %s\n' "${names[$i]}" "${rcs[$i]}" "${secs[$i]}" "$verdict"
  printf -v row '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t-' "$started" "$tree" "$mode" "${names[$i]}" \
    "${secs[$i]}" "${rcs[$i]}" "$verdict" "$class"
  rows+=("$row")
done
if [ "$mode" != fast ]; then
  [ -s "$ledger" ] || printf '#date\ttree\tmode\tstep\tseconds\trc\tverdict\tclass\tnote\n' >> "$ledger"
  printf '%s\n' "${rows[@]}" >> "$ledger"
  printf '\n'
  printf 'gate-ledger\t%s\n' "${rows[@]}"
  open=$(awk -F '\t' '$7 == "red" && $8 == "unclassified"' "$ledger" | wc -l)
  printf 'ledger: %d rows → %s; %d unclassified red(s) → uv run python .agent/gate-ledger\n' \
    "${#rows[@]}" "$ledger" "$open"
fi
exit "$fail"
