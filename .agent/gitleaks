#!/usr/bin/env bash
# gitleaks — secret scan over the whole git history with ONE pinned binary, local + CI alike
# (`.agent/spec.md` Decisions, gate tooling). Downloads the release once into gitignored `.tools/`,
# refuses it unless its sha256 matches the pin below, then scans every commit reachable from HEAD.
#   .agent/gitleaks            scan history (rc 1 on any finding)
#   .agent/gitleaks <args…>    pass args straight to the pinned binary (e.g. `dir <path>` for a seed)
set -euo pipefail
cd "$(dirname "$0")/.." || exit 2
version=8.30.1
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) asset=linux_x64 sum=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;;
  Linux-aarch64) asset=linux_arm64 sum=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080 ;;
  Darwin-arm64) asset=darwin_arm64 sum=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5 ;;
  *) echo "gitleaks: no pinned release for $(uname -s)-$(uname -m)" >&2; exit 2 ;;
esac
dir=.tools/gitleaks-$version
bin=$dir/gitleaks
if [ ! -x "$bin" ]; then
  mkdir -p "$dir"
  tarball=$dir/gitleaks_${version}_${asset}.tar.gz
  curl -fsSL -o "$tarball" \
    "https://github.com/gitleaks/gitleaks/releases/download/v$version/gitleaks_${version}_${asset}.tar.gz"
  if ! echo "$sum  $tarball" | sha256sum -c --status; then
    echo "gitleaks: sha256 mismatch for $tarball; refusing it" >&2
    rm -f "$tarball"
    exit 2
  fi
  tar -xzf "$tarball" -C "$dir" gitleaks
  rm -f "$tarball"
fi
if [ $# -gt 0 ]; then
  exec "$bin" "$@"
fi
# HEAD = the history that ships; a clean CI clone sees the same set (local branches + tags are not shipped).
exec "$bin" git --no-banner --redact --log-level warn --exit-code 1 --log-opts=HEAD .
