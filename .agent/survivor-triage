#!/usr/bin/env python3
"""survivor-triage — apply the survivor-scope rule to one `.agent/mutate` record (p93, p99-p116).

Usage: uv run python .agent/survivor-triage RECORD.txt [--workers N] [--timeout S] [--out FILE]

RECORD = a `.agent/decisions/p<nn>-mutate.txt` credit record: `mutate: <test id> @ <rev>` heads a
section, `  SURVIVED src/cement_runtime/<module>:<line> <operator> #<occurrence>` lists its
survivors. Subjects come from `.agent/decisions/survivor-subjects.json` (`test id` → list of
`module.py:Qualified.name`), the pin's named subject per `.claude/rules/assurance.md` Survivor
scope. Per survivor, at the section's revision:
  out-of-scope  its enclosing function is no subject → `contract-open` by construction
  killed        in scope, and the mutant (rebuilt with cosmic-ray at that revision) reds some test
                module that names a subject (D28's module excluded) → covered elsewhere
  survived      in scope and no such module kills it → needs a ruling (equivalent | contract-open
                | missing-test)
Prints one line per in-scope survivor + a tally; `--out` writes every verdict as JSON lines. A mutant
already replayed in this run against the same module set (sections of one record share most
mutants) takes that verdict (`note` = `memo`) instead of a second replay.
rc 0 = triaged; 2 = setup (unknown pin, unreadable record, red baseline module set).
"""

from __future__ import annotations

import argparse
import ast
import concurrent.futures
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parents[1]
SUBJECTS = ROOT / ".agent/decisions/survivor-subjects.json"
SECTION = re.compile(r"^mutate: (\S+) @ ([0-9a-f]+)")
SURVIVOR = re.compile(r"^\s+SURVIVED src/cement_runtime/(\w+\.py):(\d+) (\S+) #(\d+)$")


def _git(*args: str, cwd: pathlib.Path = ROOT) -> str:
    return subprocess.run(["git", *args], cwd=cwd, check=True, capture_output=True, text=True).stdout


def _functions(source: str) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []

    def walk(node: ast.AST, prefix: str) -> None:
        for child in ast.iter_child_nodes(node):
            if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                name = f"{prefix}{child.name}"
                if not isinstance(child, ast.ClassDef):
                    spans.append((child.lineno, child.end_lineno or child.lineno, name))
                walk(child, f"{name}.")
            else:
                walk(child, prefix)

    walk(ast.parse(source), "")
    return spans


def _enclosing(spans: list[tuple[int, int, str]], line: int) -> str | None:
    inside = [span for span in spans if span[0] <= line <= span[1]]
    return min(inside, key=lambda span: span[1] - span[0])[2] if inside else None


def _environment(tree: pathlib.Path) -> dict[str, str]:
    return dict(os.environ, PYTHONDONTWRITEBYTECODE="1",
                PYTHONPATH=os.pathsep.join([str(tree), str(tree / "src")]))


def _killers(revision: str, subjects: list[str]) -> list[str]:
    names = sorted({subject.split(":", 1)[1].rsplit(".", 1)[-1] for subject in subjects})
    found: set[str] = set()
    for name in names:
        listing = subprocess.run(["git", "grep", "-l", "-w", name, revision, "--", "tests/"],
                                 cwd=ROOT, capture_output=True, text=True).stdout
        for line in listing.splitlines():
            path = line.split(":", 1)[1]
            if path.endswith(".py") and pathlib.Path(path).name.startswith("test_"):
                found.add(path)
    found.discard("tests/test_migration_battery.py")
    return sorted(path[:-3].replace("/", ".") for path in found)


def _replay(tree: pathlib.Path, rows: list[dict[str, object]], modules: list[str],
            timeout: float) -> None:
    import cosmic_ray.plugins
    from cosmic_ray.mutating import mutate_code

    for row in rows:
        path = tree / "src/cement_runtime" / str(row["module"])
        original = path.read_text(encoding="utf-8")
        operator = cosmic_ray.plugins.get_operator(str(row["operator"]))()
        try:
            mutated = mutate_code(original, operator, int(row["occurrence"]))
            compile(mutated or "", str(path), "exec")
        except Exception:  # noqa: BLE001 — a mutant that cannot be rebuilt is reported, not run
            row["verdict"] = "unbuildable"
            continue
        if not mutated or mutated == original:
            row["verdict"] = "unbuildable"
            continue
        path.write_text(mutated, encoding="utf-8")
        try:
            result = subprocess.run([sys.executable, "-m", "unittest", *modules], cwd=tree,
                                    env=_environment(tree), capture_output=True, text=True,
                                    timeout=timeout)
            row["verdict"] = "killed" if result.returncode != 0 else "survived"
        except subprocess.TimeoutExpired:
            row["verdict"] = "killed"
            row["note"] = "timeout"
        finally:
            path.write_text(original, encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("record", type=pathlib.Path)
    parser.add_argument("--workers", type=int, default=2)
    parser.add_argument("--timeout", type=float, default=900.0)
    parser.add_argument("--out", type=pathlib.Path)
    args = parser.parse_args()
    subjects = json.loads(SUBJECTS.read_text(encoding="utf-8"))
    sections: list[tuple[str, str, list[dict[str, object]]]] = []
    for line in args.record.read_text(encoding="utf-8").splitlines():
        if (head := SECTION.match(line)) is not None:
            sections.append((head.group(1), head.group(2), []))
        elif (hit := SURVIVOR.match(line)) is not None and sections:
            sections[-1][2].append({"module": hit.group(1), "line": int(hit.group(2)),
                                    "operator": hit.group(3), "occurrence": int(hit.group(4))})
    if not sections:
        print(f"survivor-triage: no section in {args.record}", file=sys.stderr)
        return 2
    verdicts: list[dict[str, object]] = []
    memo: dict[tuple[object, ...], dict[str, object]] = {}
    for test_id, short, rows in sections:
        if test_id not in subjects:
            print(f"survivor-triage: no subject for {test_id}", file=sys.stderr)
            return 2
        revision = _git("rev-parse", "--verify", f"{short}^{{commit}}").strip()
        spans = {module: _functions(_git("show", f"{revision}:src/cement_runtime/{module}"))
                 for module in {str(row["module"]) for row in rows}}
        wanted = {tuple(subject.split(":", 1)) for subject in subjects[test_id]}
        inside: list[dict[str, object]] = []
        for row in rows:
            row["pin"] = test_id
            row["function"] = _enclosing(spans[str(row["module"])], int(row["line"]))
            if (row["module"], row["function"]) in wanted:
                inside.append(row)
            else:
                row["verdict"] = "out-of-scope"
        modules = _killers(revision, subjects[test_id])
        print(f"== {test_id} @ {short}: {len(rows)} survivors, {len(inside)} in scope "
              f"{sorted(subjects[test_id])}; killers {len(modules)} modules")

        def key(row: dict[str, object]) -> tuple[object, ...]:
            return (revision, row["module"], row["operator"], row["occurrence"], tuple(modules))

        fresh = [row for row in inside if key(row) not in memo]
        for row in inside:
            if key(row) in memo:
                row.update(memo[key(row)], note="memo")
        if fresh:
            with tempfile.TemporaryDirectory(prefix="cement-triage-") as directory:
                trees = [pathlib.Path(directory) / f"tree-{index}" for index in range(args.workers)]
                try:
                    for tree in trees:
                        _git("worktree", "add", "--detach", str(tree), revision)
                    baseline = subprocess.run([sys.executable, "-m", "unittest", *modules],
                                              cwd=trees[0], env=_environment(trees[0]),
                                              capture_output=True, text=True)
                    if baseline.returncode != 0:
                        print(f"survivor-triage: killer modules red at {short}:\n"
                              f"{baseline.stderr[-3000:]}", file=sys.stderr)
                        return 2
                    shares = [fresh[index::args.workers] for index in range(args.workers)]
                    with concurrent.futures.ThreadPoolExecutor(args.workers) as pool:
                        list(pool.map(lambda pair: _replay(pair[0], pair[1], modules, args.timeout),
                                      zip(trees, shares, strict=True)))
                finally:
                    for tree in trees:
                        subprocess.run(["git", "worktree", "remove", "--force", str(tree)],
                                       cwd=ROOT, capture_output=True)
            for row in fresh:
                memo[key(row)] = {name: row[name] for name in ("verdict", "note") if name in row}
        for row in inside:
            print(f"  {row['verdict']:<11} {row['module']}:{row['line']} {row['function']} "
                  f"{row['operator']} #{row['occurrence']}{' (memo)' if row.get('note') == 'memo' else ''}")
        verdicts.extend(rows)
    tally: dict[str, int] = {}
    for row in verdicts:
        tally[str(row["verdict"])] = tally.get(str(row["verdict"]), 0) + 1
    print("survivor-triage: " + ", ".join(f"{key} {value}" for key, value in sorted(tally.items())))
    if args.out is not None:
        args.out.write_text("".join(json.dumps(row, sort_keys=True) + "\n" for row in verdicts),
                            encoding="utf-8")
    return 0


if __name__ == "__main__":
    sys.exit(main())
