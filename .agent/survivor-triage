#!/usr/bin/env python3
"""survivor-triage — apply the survivor-scope rule to one `.agent/mutate` record (p93, p99-p116).

Usage: uv run python .agent/survivor-triage RECORD.txt [--workers N] [--timeout S] [--out FILE]

RECORD = a `.agent/decisions/p<nn>-mutate.txt` credit record: `mutate: <test id> @ <rev>` heads a
section, `  SURVIVED src/cement_runtime/<module>:<line> <operator> #<occurrence>` lists its
survivors. Subjects come from `.agent/decisions/survivor-subjects.json` (`test id` → list of
`module.py:Qualified.name`), the pin's named subject per `.claude/rules/assurance.md` Survivor
scope. Per survivor, at the section's revision:
  out-of-scope  its enclosing function is no subject, nor nested in one → `contract-open` by construction
  killed        in scope, and the mutant (rebuilt with cosmic-ray at that revision) reds some test
                module that names a subject (D28's module excluded) → covered elsewhere
  survived      in scope and no such module kills it → needs a ruling (equivalent | contract-open
                | missing-test)
`--at REV --from FILE` replays the survivors FILE (an earlier `--out`) marks `survived` against REV's
suite instead: each mutant's changed line block (at the record's revision) is re-anchored in REV's
source by exact text (inside the subject's span where the text repeats), then REV's modules naming a
subject run on it — `killed-at` (a later test covers it), `survived-at` (the residue to rule),
`superseded` (REV no longer holds the code), `ambiguous` (the text is not unique in the span).
`--full` (with `--at`) replays against every test module but D28's and `tests/test_source.py` (it
times subprocesses, so load would read as kills): the row's "full suite minus D28" — a module that
exercises the subject through public API without naming it kills there.
Prints one line per in-scope survivor + a tally; `--out` writes every verdict as JSON lines. A mutant
already replayed in this run against the same module set (sections of one record share most
mutants) takes that verdict (`note` = `memo`) instead of a second replay.
rc 0 = triaged; 2 = setup (unknown pin, unreadable record, red baseline module set).
"""

from __future__ import annotations

import argparse
import ast
import concurrent.futures
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parents[1]
SUBJECTS = ROOT / ".agent/decisions/survivor-subjects.json"
SECTION = re.compile(r"^mutate: (\S+) @ ([0-9a-f]+)")
SURVIVOR = re.compile(r"^\s+SURVIVED (?:src/cement_runtime/)?([\w/.-]+\.py):(\d+) (\S+) #(\d+)$")


def _path(module: str) -> str:
    # `src/cement_runtime` modules are keyed by file name; a `.agent/mutate --subject` file elsewhere
    # (p93: `examples/open_webui/cement_filter.py`) by its repo path.
    return module if "/" in module else f"src/cement_runtime/{module}"


def _git(*args: str, cwd: pathlib.Path = ROOT) -> str:
    return subprocess.run(["git", *args], cwd=cwd, check=True, capture_output=True, text=True).stdout


def _functions(source: str) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []

    def walk(node: ast.AST, prefix: str) -> None:
        for child in ast.iter_child_nodes(node):
            if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                name = f"{prefix}{child.name}"
                if not isinstance(child, ast.ClassDef):
                    spans.append((child.lineno, child.end_lineno or child.lineno, name))
                walk(child, f"{name}.")
            else:
                walk(child, prefix)

    walk(ast.parse(source), "")
    return spans


def _enclosing(spans: list[tuple[int, int, str]], line: int) -> str | None:
    inside = [span for span in spans if span[0] <= line <= span[1]]
    return min(inside, key=lambda span: span[1] - span[0])[2] if inside else None


def _environment(tree: pathlib.Path) -> dict[str, str]:
    return dict(os.environ, PYTHONDONTWRITEBYTECODE="1",
                PYTHONPATH=os.pathsep.join([str(tree), str(tree / "src")]))


def _control(tree: pathlib.Path, modules: list[str], timeout: float | None = None) -> bool:
    if not modules:
        print("CONTROL red: no selected tests", file=sys.stderr)
        return False
    try:
        result = subprocess.run([sys.executable, "-m", "unittest", *modules], cwd=tree,
                                env=_environment(tree), capture_output=True, text=True,
                                timeout=timeout)
    except subprocess.TimeoutExpired:
        print(f"CONTROL red: {modules} timed out", file=sys.stderr)
        return False
    counts = re.findall(r"^Ran (\d+) tests? in", result.stderr, flags=re.MULTILINE)
    ran = int(counts[-1]) if counts else 0
    passed = result.returncode == 0 and ran > 0
    print(f"CONTROL {'green' if passed else 'red'}: {modules}; rc {result.returncode}, ran {ran}")
    if not passed:
        print(result.stderr[-3000:], file=sys.stderr)
    return passed


def _killers(revision: str, subjects: list[str]) -> list[str]:
    names = sorted({subject.split(":", 1)[1].rsplit(".", 1)[-1] for subject in subjects})
    found: set[str] = set()
    for name in names:
        listing = subprocess.run(["git", "grep", "-l", "-w", name, revision, "--", "tests/"],
                                 cwd=ROOT, capture_output=True, text=True).stdout
        for line in listing.splitlines():
            path = line.split(":", 1)[1]
            if path.endswith(".py") and pathlib.Path(path).name.startswith("test_"):
                found.add(path)
    found.discard("tests/test_migration_battery.py")
    return sorted(path[:-3].replace("/", ".") for path in found)


# Generated copies embed these sources; a mutant left un-regenerated reds their freshness tests
# (W1, N7) whatever it does, a phantom kill, and a umask-0077 checkout leaves `ext/bin/cement` at
# 0700, which N7 reads as stale before any mutant. Every tree regenerates after checkout and around
# each mutant (≈ 0.2 s); regenerated, those modules judge the mutant's code.
GENERATORS = ("examples/open_webui/generate.py", "examples/nucllei/generate.py")
GENERATED = ("examples/open_webui/paste-in", "examples/nucllei/ext/bin/cement")


def _regenerate(tree: pathlib.Path) -> bool:
    # An older record revision predates some generators; regenerate what that tree ships.
    for generator in (name for name in GENERATORS if (tree / name).is_file()):
        if subprocess.run([sys.executable, generator], cwd=tree, env=_environment(tree),
                          capture_output=True, text=True).returncode != 0:
            return False
    return True


def _restore_generated(tree: pathlib.Path) -> None:
    shipped = [name for name in GENERATED if (tree / name).exists()]
    if shipped:
        subprocess.run(["git", "-C", str(tree), "checkout", "--", *shipped], capture_output=True, check=True)
        _regenerate(tree)  # the checkout re-applies the umask to `ext/bin/cement`


def _replay(tree: pathlib.Path, rows: list[dict[str, object]], modules: list[str],
            timeout: float) -> None:
    import cosmic_ray.plugins
    from cosmic_ray.mutating import mutate_code

    for row in rows:
        path = tree / _path(str(row["module"]))
        original = path.read_text(encoding="utf-8")
        operator = cosmic_ray.plugins.get_operator(str(row["operator"]))()
        try:
            mutated = mutate_code(original, operator, int(row["occurrence"]))
            compile(mutated or "", str(path), "exec")
        except Exception:  # noqa: BLE001 — a mutant that cannot be rebuilt is reported, not run
            row["verdict"] = "unbuildable"
            continue
        if not mutated or mutated == original:
            row["verdict"] = "unbuildable"
            continue
        path.write_text(mutated, encoding="utf-8")
        try:
            if not _regenerate(tree):
                # The gate's freshness tests run the generators, so a mutant they refuse is detected.
                row["verdict"] = "killed"
                row["note"] = "generator refused"
                continue
            result = subprocess.run([sys.executable, "-m", "unittest", *modules], cwd=tree,
                                    env=_environment(tree), capture_output=True, text=True,
                                    timeout=timeout)
            row["verdict"] = "killed" if result.returncode != 0 else "survived"
        except subprocess.TimeoutExpired:
            row["verdict"] = "killed"
            row["note"] = "timeout"
        finally:
            path.write_text(original, encoding="utf-8")
            _restore_generated(tree)


def _suite(revision: str) -> list[str]:
    listed = _git("ls-tree", "--name-only", f"{revision}:tests").split()
    excluded = {"test_migration_battery.py", "test_source.py"}
    return sorted(f"tests.{name[:-3]}" for name in listed
                  if name.startswith("test_") and name.endswith(".py") and name not in excluded)


def _hunk(original: str, mutated: str) -> tuple[list[str], list[str]] | None:
    import difflib

    before, after = original.splitlines(keepends=True), mutated.splitlines(keepends=True)
    changes = [op for op in difflib.SequenceMatcher(a=before, b=after, autojunk=False).get_opcodes()
               if op[0] != "equal"]
    if len(changes) != 1:
        return None
    _, i1, i2, j1, j2 = changes[0]
    return before[i1:i2], after[j1:j2]


def _at(args: argparse.Namespace, subjects: dict[str, list[str]],
        revisions: dict[str, str]) -> int:
    import cosmic_ray.plugins
    from cosmic_ray.mutating import mutate_code

    target = _git("rev-parse", "--verify", f"{args.at}^{{commit}}").strip()
    rows = [json.loads(line) for line in args.from_file.read_text(encoding="utf-8").splitlines()
            if line.strip()]
    # A `--from` file may itself be an `--at` output: replay what survived there.
    rows = [row for row in rows
            if row.get("verdict_at", row.get("verdict")) in ("survived", "survived-at")]
    sources: dict[tuple[str, str], str] = {}

    def source(revision: str, module: str) -> str:
        if (revision, module) not in sources:
            sources[(revision, module)] = _git("show", f"{revision}:{_path(module)}")
        return sources[(revision, module)]

    jobs: dict[tuple[object, ...], list[dict[str, object]]] = {}
    for row in rows:
        module, pin = str(row["module"]), str(row["pin"])
        original = source(revisions[pin], module)
        operator = cosmic_ray.plugins.get_operator(str(row["operator"]))()
        hunk = _hunk(original, mutate_code(original, operator, int(row["occurrence"])) or original)
        here = source(target, module).splitlines(keepends=True)
        if hunk is None:
            row["verdict_at"] = "ambiguous"
            continue
        old, new = hunk
        starts = [index for index in range(len(here) - len(old) + 1) if here[index:index + len(old)] == old]
        if len(starts) > 1:
            spans = [span for span in _functions("".join(here)) if span[2] == row["function"]]
            starts = [start for start in starts
                      if any(first <= start + 1 <= last for first, last, _ in spans)]
        if not starts:
            # Moved code (an extracted helper) keeps its text at another indentation: match the
            # stripped block once in the whole module, then re-indent the new lines to it.
            stripped = [line.strip() for line in old]
            moved = [index for index in range(len(here) - len(old) + 1)
                     if [line.strip() for line in here[index:index + len(old)]] == stripped]
            if len(moved) == 1 and old and old[0].strip():
                shift = len(here[moved[0]]) - len(here[moved[0]].lstrip()) - (len(old[0]) - len(old[0].lstrip()))
                new = [(" " * shift + line) if shift >= 0 else line[-shift:] for line in new]
                starts = moved
                row["note"] = "re-indented"
        if not starts:
            row["verdict_at"] = "superseded"
            continue
        if len(starts) > 1:
            row["verdict_at"] = "ambiguous"
            continue
        mutated = "".join(here[:starts[0]] + new + here[starts[0] + len(old):])
        modules = tuple(_suite(target) if args.full else _killers(target, subjects[pin]))
        jobs.setdefault((module, mutated, modules), []).append(row)
    keys = list(jobs)
    with tempfile.TemporaryDirectory(prefix="cement-triage-at-") as directory:
        trees = [pathlib.Path(directory) / f"tree-{index}" for index in range(args.workers)]
        try:
            for tree in trees:
                _git("worktree", "add", "--detach", str(tree), target)
                if not _regenerate(tree):
                    print("survivor-triage: CONTROL red: generator refused", file=sys.stderr)
                    return 2

            def run(tree: pathlib.Path, share: list[tuple[object, ...]]) -> None:
                for module, mutated, modules in share:
                    path = tree / _path(str(module))
                    original = path.read_text(encoding="utf-8")
                    path.write_text(str(mutated), encoding="utf-8")
                    try:
                        if not _regenerate(tree):
                            verdict = "killed-at"
                        else:
                            result = subprocess.run(
                                [sys.executable, "-m", "unittest", *modules], cwd=tree,
                                env=_environment(tree), capture_output=True, text=True,
                                timeout=args.timeout)
                            verdict = "killed-at" if result.returncode != 0 else "survived-at"
                    except subprocess.TimeoutExpired:
                        verdict = "killed-at"
                    finally:
                        path.write_text(original, encoding="utf-8")
                        _restore_generated(tree)
                    for row in jobs[(module, mutated, modules)]:
                        row["verdict_at"] = verdict

            shares = [keys[index::args.workers] for index in range(args.workers)]

            def control(tree: pathlib.Path, share: list[tuple[object, ...]]) -> bool:
                return all(_control(tree, list(modules), args.timeout)
                           for modules in sorted({key[2] for key in share}))

            with concurrent.futures.ThreadPoolExecutor(args.workers) as pool:
                controls = list(pool.map(lambda pair: control(*pair), zip(trees, shares, strict=True)))
                if not all(controls):
                    return 2
                list(pool.map(lambda pair: run(*pair), zip(trees, shares, strict=True)))
        finally:
            for tree in trees:
                subprocess.run(["git", "worktree", "remove", "--force", str(tree)], cwd=ROOT,
                               capture_output=True)
    for row in rows:
        print(f"  {row['verdict_at']:<12} {row['module']}:{row['line']} {row['function']} "
              f"{row['operator']} #{row['occurrence']}")
    tally: dict[str, int] = {}
    for row in rows:
        tally[str(row["verdict_at"])] = tally.get(str(row["verdict_at"]), 0) + 1
    print(f"survivor-triage --at {target[:12]}: {len(keys)} distinct replays; "
          + ", ".join(f"{key} {value}" for key, value in sorted(tally.items())))
    if args.out is not None:
        args.out.write_text("".join(json.dumps(row, sort_keys=True) + "\n" for row in rows),
                            encoding="utf-8")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("record", type=pathlib.Path)
    parser.add_argument("--workers", type=int, default=2)
    parser.add_argument("--timeout", type=float, default=900.0)
    parser.add_argument("--out", type=pathlib.Path)
    parser.add_argument("--at")
    parser.add_argument("--from", dest="from_file", type=pathlib.Path)
    parser.add_argument("--full", action="store_true")
    args = parser.parse_args()
    if (args.at is None) != (args.from_file is None):
        parser.error("--at and --from go together")
    subjects = json.loads(SUBJECTS.read_text(encoding="utf-8"))
    sections: list[tuple[str, str, list[dict[str, object]]]] = []
    for line in args.record.read_text(encoding="utf-8").splitlines():
        if (head := SECTION.match(line)) is not None:
            sections.append((head.group(1), head.group(2), []))
        elif (hit := SURVIVOR.match(line)) is not None and sections:
            sections[-1][2].append({"module": hit.group(1), "line": int(hit.group(2)),
                                    "operator": hit.group(3), "occurrence": int(hit.group(4))})
    if not sections:
        print(f"survivor-triage: no section in {args.record}", file=sys.stderr)
        return 2
    if args.at is not None:
        revisions = {test_id: _git("rev-parse", "--verify", f"{short}^{{commit}}").strip()
                     for test_id, short, _ in sections}
        return _at(args, subjects, revisions)
    verdicts: list[dict[str, object]] = []
    memo: dict[tuple[object, ...], dict[str, object]] = {}
    for test_id, short, rows in sections:
        if test_id not in subjects:
            print(f"survivor-triage: no subject for {test_id}", file=sys.stderr)
            return 2
        revision = _git("rev-parse", "--verify", f"{short}^{{commit}}").strip()
        spans = {module: _functions(_git("show", f"{revision}:{_path(module)}"))
                 for module in {str(row["module"]) for row in rows}}
        wanted = {tuple(subject.split(":", 1)) for subject in subjects[test_id]}
        inside: list[dict[str, object]] = []
        for row in rows:
            row["pin"] = test_id
            row["function"] = _enclosing(spans[str(row["module"])], int(row["line"]))
            # A definition nested inside a subject (`System._pin_checks.count`) is part of it.
            if any(row["module"] == module and (row["function"] == name or str(row["function"]).startswith(f"{name}."))
                   for module, name in wanted):
                inside.append(row)
            else:
                row["verdict"] = "out-of-scope"
        modules = _killers(revision, subjects[test_id])
        print(f"== {test_id} @ {short}: {len(rows)} survivors, {len(inside)} in scope "
              f"{sorted(subjects[test_id])}; killers {len(modules)} modules")

        def key(row: dict[str, object]) -> tuple[object, ...]:
            return (revision, row["module"], row["operator"], row["occurrence"], tuple(modules))

        fresh = [row for row in inside if key(row) not in memo]
        for row in inside:
            if key(row) in memo:
                row.update(memo[key(row)], note="memo")
        if fresh:
            with tempfile.TemporaryDirectory(prefix="cement-triage-") as directory:
                trees = [pathlib.Path(directory) / f"tree-{index}" for index in range(args.workers)]
                try:
                    for tree in trees:
                        _git("worktree", "add", "--detach", str(tree), revision)
                        _regenerate(tree)
                    baseline = subprocess.run([sys.executable, "-m", "unittest", *modules],
                                              cwd=trees[0], env=_environment(trees[0]),
                                              capture_output=True, text=True)
                    if baseline.returncode != 0:
                        print(f"survivor-triage: killer modules red at {short}:\n"
                              f"{baseline.stderr[-3000:]}", file=sys.stderr)
                        return 2
                    shares = [fresh[index::args.workers] for index in range(args.workers)]
                    with concurrent.futures.ThreadPoolExecutor(args.workers) as pool:
                        list(pool.map(lambda pair: _replay(pair[0], pair[1], modules, args.timeout),
                                      zip(trees, shares, strict=True)))
                finally:
                    for tree in trees:
                        subprocess.run(["git", "worktree", "remove", "--force", str(tree)],
                                       cwd=ROOT, capture_output=True)
            for row in fresh:
                memo[key(row)] = {name: row[name] for name in ("verdict", "note") if name in row}
        for row in inside:
            print(f"  {row['verdict']:<11} {row['module']}:{row['line']} {row['function']} "
                  f"{row['operator']} #{row['occurrence']}{' (memo)' if row.get('note') == 'memo' else ''}")
        verdicts.extend(rows)
    tally: dict[str, int] = {}
    for row in verdicts:
        tally[str(row["verdict"])] = tally.get(str(row["verdict"]), 0) + 1
    print("survivor-triage: " + ", ".join(f"{key} {value}" for key, value in sorted(tally.items())))
    if args.out is not None:
        args.out.write_text("".join(json.dumps(row, sort_keys=True) + "\n" for row in verdicts),
                            encoding="utf-8")
    return 0


if __name__ == "__main__":
    sys.exit(main())
