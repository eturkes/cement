#!/usr/bin/env python3
"""suite — `unittest discover -s tests -t .` or the named tests, optionally minus D28 as a NAMED split run.

D28 is the only gate grading history (`.claude/rules/history-gates.md`); a run without it says so
on stderr and names the omitted id, so a split result never reads as the full gate. With names
(the fast gate, `.claude/rules/ops.md`) `--omit-d28` drops D28 only where a name reaches it: a
history replay scales with every unverdicted revision, which a latency-bounded iteration excludes.

Usage: uv run python .agent/suite [--omit-d28] [--durations N] [tests.module …]
"""

from __future__ import annotations

import argparse
import os
import sys
import unittest
from collections.abc import Iterator

D28 = (
    "tests.test_migration_battery.MigrationBatteryTests."
    "test_d28_gate_1_stays_green_at_every_commit_never_only_at_the_last"
)


def _flatten(suite: unittest.TestSuite) -> Iterator[unittest.TestCase]:
    for item in suite:
        if isinstance(item, unittest.TestSuite):
            yield from _flatten(item)
        else:
            yield item


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="suite")
    parser.add_argument("--omit-d28", action="store_true")
    parser.add_argument("--durations", type=int)
    parser.add_argument("names", nargs="*")
    args = parser.parse_args(argv[1:])
    loader = unittest.defaultTestLoader
    if args.names:
        # `python -m unittest <names>` imports from the working directory; a script run puts its
        # own directory first instead.
        sys.path.insert(0, os.path.abspath("."))
        tests = list(_flatten(loader.loadTestsFromNames(args.names)))
    else:
        tests = list(_flatten(loader.discover("tests", top_level_dir=".")))
    kept = [test for test in tests if not (args.omit_d28 and test.id() == D28)]
    omitted = len(tests) - len(kept)
    if args.omit_d28:
        if omitted > 1 or (omitted == 0 and not args.names):
            print(f"suite: expected to omit exactly one test ({D28}), omitted {omitted}", file=sys.stderr)
            return 2
        if omitted:
            print(f"suite: SPLIT RUN — omits {D28}; history ungraded by this run", file=sys.stderr)
    runner = (unittest.TextTestRunner(durations=args.durations) if args.durations is not None
              else unittest.TextTestRunner())
    result = runner.run(unittest.TestSuite(kept))
    return 0 if result.wasSuccessful() else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
