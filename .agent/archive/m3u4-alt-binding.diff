+def _proposal_binding_from_row(
+    row: sqlite3.Row,
+    *,
+    partition: str,
+) -> _ProposalBinding:
+    try:
+        if row["request_id"] is None:
+            raise IntegrityError("proposal request binding is missing")
+        proposal_id = _request_id(row["proposal_id"])
+        proposal_partition = _name(
+            row["proposal_partition"],
+            "stored proposal partition",
+        )
+        proposal_request_id = _request_id(row["proposal_request_id"])
+        proposal_status = row["proposal_status"]
+        if type(proposal_status) is not str:
+            raise TypeError("proposal status is not a string")
+        request_id = _request_id(row["request_id"])
+        request_partition = _name(
+            row["request_partition"],
+            "stored proposal request partition",
+        )
+        operation = _name(
+            row["operation"],
+            "stored proposal operation",
+        )
+        operation_revision = _stored_int(
+            row["operation_revision"],
+            "proposal binding operation revision",
+            minimum=1,
+        )
+        input_json = row["input_json"]
+        if type(input_json) is not str:
+            raise TypeError("proposal input text is not a string")
+        input_hash = _digest(
+            row["input_hash"],
+            "proposal binding input hash",
+        )
+        request_status = row["request_status"]
+        if type(request_status) is not str:
+            raise TypeError("proposal request status is not a string")
+        request_proposal_id = _request_id(row["request_proposal_id"])
+    except IntegrityError:
+        raise
+    except (IndexError, KeyError, TypeError, ValidationError) as exc:
+        raise IntegrityError("proposal binding has invalid scalar fields") from exc
+    expected_request_status = {
+        "pending": "pending",
+        "accepted": "resolved",
+        "corrected": "resolved",
+        "rejected": "rejected",
+    }.get(proposal_status)
+    if expected_request_status is None:
+        raise IntegrityError("proposal has an unknown status")
+    if (
+        proposal_partition != partition
+        or request_partition != partition
+        or proposal_request_id != request_id
+        or request_proposal_id != proposal_id
+        or request_status != expected_request_status
+    ):
+        raise IntegrityError("proposal request binding is inconsistent")
+    return _ProposalBinding(
+        proposal_id=proposal_id,
+        request_id=request_id,
+        partition=partition,
+        operation=operation,
+        operation_revision=operation_revision,
+        input_json=input_json,
+        input_hash=input_hash,
+        status=request_status,
+    )
+
+
+def _proposal_bindings(
+    connection: sqlite3.Connection,
+    *,
+    partition: str,
+    selection: _ProposalIds | _PendingProposalSelection,
+) -> _ProposalBindingSet:
+    if type(selection) is _ProposalIds:
+        proposal_ids = selection.values
+        if not proposal_ids:
+            return _ProposalBindingSet(total=0, rows=())
+        if len(set(proposal_ids)) != len(proposal_ids):
+            raise IntegrityError("proposal binding selection contains duplicate identifiers")
+        placeholders = ", ".join("?" for _ in proposal_ids)
+        rows = connection.execute(
+            f"""
+            SELECT p.id AS proposal_id,
+                   p.partition AS proposal_partition,
+                   p.request_id AS proposal_request_id,
+                   p.status AS proposal_status,
+                   r.id AS request_id,
+                   r.partition AS request_partition,
+                   r.operation,
+                   r.operation_revision,
+                   r.input_json,
+                   r.input_hash,
+                   r.status AS request_status,
+                   r.proposal_id AS request_proposal_id
+            FROM proposals AS p
+            LEFT JOIN requests AS r
+              ON r.partition = p.partition AND r.id = p.request_id
+            WHERE p.partition = ? AND p.id IN ({placeholders})
+            """,
+            (partition, *proposal_ids),
+        ).fetchall()
+        if len(rows) != len(proposal_ids):
+            raise IntegrityError("proposal binding row is missing")
+        bindings = tuple(
+            _proposal_binding_from_row(row, partition=partition)
+            for row in rows
+        )
+        by_id = {binding.proposal_id: binding for binding in bindings}
+        if len(by_id) != len(proposal_ids) or any(
+            proposal_id not in by_id for proposal_id in proposal_ids
+        ):
+            raise IntegrityError("proposal binding selection is inconsistent")
+        return _ProposalBindingSet(
+            total=len(proposal_ids),
+            rows=tuple(by_id[proposal_id] for proposal_id in proposal_ids),
+        )
+    if type(selection) is not _PendingProposalSelection:
+        raise IntegrityError("proposal binding selection is invalid")
+
+    issue = connection.execute(
+        """
+        SELECT issue FROM (
+            SELECT CASE
+                       WHEN r.id IS NULL THEN 'missing-request'
+                       ELSE 'inconsistent'
+                   END AS issue
+            FROM proposals AS p
+            LEFT JOIN requests AS r
+              ON r.partition = p.partition AND r.id = p.request_id
+            WHERE p.partition = ? AND p.status = 'pending'
+              AND (
+                  r.id IS NULL
+                  OR r.proposal_id <> p.id
+                  OR r.status <> 'pending'
+              )
+            UNION ALL
+            SELECT CASE
+                       WHEN p.id IS NULL THEN 'missing-proposal'
+                       ELSE 'inconsistent'
+                   END AS issue
+            FROM requests AS r
+            LEFT JOIN proposals AS p
+              ON p.partition = r.partition AND p.request_id = r.id
+            WHERE r.partition = ? AND r.operation = ? AND r.status = 'pending'
+              AND (
+                  p.id IS NULL
+                  OR p.id <> r.proposal_id
+                  OR p.status <> 'pending'
+              )
+        )
+        LIMIT 1
+        """,
+        (partition, partition, selection.operation),
+    ).fetchone()
+    if issue is not None:
+        if issue["issue"] == "missing-request":
+            raise IntegrityError("proposal request binding is missing")
+        if issue["issue"] == "missing-proposal":
+            raise IntegrityError("pending request proposal binding is missing")
+        raise IntegrityError("proposal request binding is inconsistent")
+
+    rows = connection.execute(
+        """
+        WITH selected AS (
+            SELECT p.id AS proposal_id,
+                   p.partition AS proposal_partition,
+                   p.request_id AS proposal_request_id,
+                   p.status AS proposal_status,
+                   r.id AS request_id,
+                   r.partition AS request_partition,
+                   r.operation,
+                   r.operation_revision,
+                   r.input_json,
+                   r.input_hash,
+                   r.status AS request_status,
+                   r.proposal_id AS request_proposal_id
+            FROM proposals AS p
+            JOIN requests AS r
+              ON r.partition = p.partition AND r.id = p.request_id
+            WHERE p.partition = ? AND p.status = 'pending' AND r.operation = ?
+        ),
+        projected AS (
+            SELECT * FROM selected ORDER BY proposal_id LIMIT ?
+        ),
+        counted AS (
+            SELECT COUNT(*) AS item_count FROM selected
+        )
+        SELECT counted.item_count, projected.*
+        FROM counted LEFT JOIN projected ON 1 = 1
+        ORDER BY projected.proposal_id
+        """,
+        (partition, selection.operation, selection.limit),
+    ).fetchall()
+    if not rows:
+        raise IntegrityError("pending proposal binding count is missing")
+    total = _stored_int(rows[0]["item_count"], "pending proposal count")
+    bindings = tuple(
+        _proposal_binding_from_row(row, partition=partition)
+        for row in rows
+        if row["proposal_id"] is not None
+    )
+    if len(bindings) != min(total, selection.limit):
+        raise IntegrityError("pending proposal binding projection count mismatch")
+    return _ProposalBindingSet(total=total, rows=bindings)
+
+
+def _proposal_binding(
+    connection: sqlite3.Connection,
+    *,
+    partition: str,
+    proposal_id: str,
+) -> _ProposalBinding:
+    result = _proposal_bindings(
+        connection,
+        partition=partition,
+        selection=_ProposalIds((proposal_id,)),
+    )
+    if result.total != 1 or len(result.rows) != 1:
+        raise IntegrityError("proposal binding lookup returned the wrong cardinality")
+    return result.rows[0]
+
+
+def _write_proposal_request_status(
+    connection: sqlite3.Connection,
+    *,
+    binding: _ProposalBinding,
+    status: Literal["rejected", "resolved"],
+    final: CanonicalJSON | None,
+    example_id: str | None,
+    now_us: int,
+) -> int:
+    if status == "rejected":
+        if final is not None or example_id is not None:
+            raise IntegrityError("rejected proposal request update carried resolved fields")
+        cursor = connection.execute(
+            """
+            UPDATE requests SET status = 'rejected', updated_at_us = ?
+            WHERE partition = ? AND id = ? AND status = 'pending'
+              AND proposal_id = ?
+            """,
+            (now_us, binding.partition, binding.request_id, binding.proposal_id),
+        )
+    else:
+        if final is None or example_id is None:
+            raise IntegrityError("resolved proposal request update omitted resolved fields")
+        cursor = connection.execute(
+            """
+            UPDATE requests
+            SET status = 'resolved', output_json = ?, source_kind = 'confirmed',
+                example_id = ?, updated_at_us = ?
+            WHERE partition = ? AND id = ? AND status = 'pending'
+              AND proposal_id = ?
+            """,
+            (
+                final.text,
+                example_id,
+                now_us,
+                binding.partition,
+                binding.request_id,
+                binding.proposal_id,
+            ),
+        )
+    return cursor.rowcount
+
