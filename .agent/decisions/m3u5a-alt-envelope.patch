+def _submission(value: str) -> dict[str, JSONValue]:
+    if value == "-":
+        binary = getattr(sys.stdin, "buffer", None)
+        try:
+            source = (
+                binary.read(_SUBMISSION_MAX_BYTES + 1)
+                if binary is not None
+                else sys.stdin.read(_SUBMISSION_MAX_BYTES + 1)
+            )
+        except OSError as exc:
+            raise ValidationError("submission stdin could not be read") from exc
+        if len(source) > _SUBMISSION_MAX_BYTES:
+            unit = "bytes" if binary is not None else "characters"
+            raise ValidationError(f"submission stdin exceeds {_SUBMISSION_MAX_BYTES} {unit}")
+        if binary is not None:
+            try:
+                source = source.decode("utf-8")
+            except UnicodeDecodeError as exc:
+                raise ValidationError("submission stdin is not valid UTF-8") from exc
+    elif value.startswith("@"):
+        if value == "@":
+            raise ValidationError("submission file path is empty")
+        try:
+            with pathlib.Path(value[1:]).open("rb") as stream:
+                raw = stream.read(_SUBMISSION_MAX_BYTES + 1)
+        except OSError as exc:
+            raise ValidationError(f"submission file could not be read: {exc}") from exc
+        if len(raw) > _SUBMISSION_MAX_BYTES:
+            raise ValidationError(
+                f"submission file exceeds {_SUBMISSION_MAX_BYTES} bytes"
+            )
+        try:
+            source = raw.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise ValidationError("submission file is not valid UTF-8") from exc
+    else:
+        source = value
+    submission = parse_json(
+        source,
+        max_bytes=_SUBMISSION_MAX_BYTES,
+        max_depth=_SUBMISSION_MAX_DEPTH,
+        max_items=_SUBMISSION_MAX_ITEMS,
+    ).value
+    if type(submission) is not dict:
+        raise ValidationError("submission must be a JSON object")
+    unexpected = sorted(set(submission) - _SUBMISSION_KEYS)
+    if unexpected:
+        raise ValidationError(f"submission has unknown keys: {', '.join(unexpected)}")
+    missing = sorted(_SUBMISSION_REQUIRED_KEYS - set(submission))
+    if missing:
+        raise ValidationError(f"submission is missing keys: {', '.join(missing)}")
+    return submission
+
