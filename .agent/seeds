def run(argv, cwd, *, env=None, timeout=None):
    environment = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
    for key in ("VIRTUAL_ENV", "UV_PROJECT_ENVIRONMENT", "CEMENT_D28_INNER_REPLAY"):
        environment.pop(key, None)
    environment["PYTHONPATH"] = os.pathsep.join((str(cwd), str(Path(cwd) / "src")))
    if env:
        for key, value in env.items():
            if value is None:
                environment.pop(key, None)
            else:
                environment[key] = value
    command = [str(arg) for arg in argv]
    # Noninteractive background shells can pass SIG_IGN; the historical p25
    # interrupt probe requires the ordinary executable signal dispositions.
    def signals():
        for sig in (signal.SIGINT, signal.SIGPIPE, signal.SIGXFSZ):
            signal.signal(sig, signal.SIG_DFL)
    started = time.monotonic()
    process = subprocess.Popen(command, cwd=cwd, env=environment, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True, start_new_session=True,
                               preexec_fn=signals if os.name == "posix" else None)
    try:
        output, _ = process.communicate(timeout=timeout)
    except BaseException as exc:
        if os.name == "posix":
            os.killpg(process.pid, signal.SIGTERM)
        else:
            process.terminate()
        try:
            output, _ = process.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            if os.name == "posix":
                os.killpg(process.pid, signal.SIGKILL)
            else:
                process.kill()
            output, _ = process.communicate()
        if not isinstance(exc, subprocess.TimeoutExpired):
            raise
        return 124, output + "\nSEED-TIMEOUT\n", time.monotonic() - started
    return process.returncode, output, time.monotonic() - started


def git(root, *args):
    rc, output, _ = run(["git", *args], root)
    if rc:
        raise RuntimeError(f"git {' '.join(args)}: rc={rc} {output[-2000:]}")
    return output.strip()


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def tracked_digest(root):
    names = git(root, "ls-files", "-z").split("\0")
    return {name: (digest(root / name), (root / name).stat().st_mode & 0o777)
            for name in names if name}


@contextlib.contextmanager
def changed(path, text=None):
    original = path.read_bytes() if path.exists() else None
    mode = path.stat().st_mode if original is not None else None
    before = hashlib.sha256(original).hexdigest() if original is not None else "absent"
    path.parent.mkdir(parents=True, exist_ok=True)
    if text is None:
        path.unlink(missing_ok=True)
    else:
        path.write_bytes(text if isinstance(text, bytes) else text.encode())
    try:
        yield
    finally:
        if original is None:
            path.unlink(missing_ok=True)
        else:
            path.write_bytes(original)
            path.chmod(mode)
        after = digest(path) if path.exists() else "absent"
        if before != after:
            raise RuntimeError(f"RESTORE-DIFF {path}: {before} != {after}")
        print(f"RESTORED {path.name} sha256={after}", flush=True)


def replace(text, old, new):
    count = text.count(old)
    if count != 1:
        raise RuntimeError(f"anchor count={count}, want 1: {old!r}")
    return text.replace(old, new, 1)


def substitute(text, pattern, new):
    """`re.sub` with `replace`'s guard: a missed anchor would otherwise plant nothing."""

    result, count = re.subn(pattern, new, text)
    if count != 1:
        raise RuntimeError(f"pattern count={count}, want 1: {pattern!r}")
    return result


class Runner:
    def __init__(self, revision, temporary):
        self.temp = Path(temporary)
        self.repo = self.temp / "repo.git"
        git(ROOT, "clone", "--mirror", "--shared", str(ROOT), str(self.repo))
        self.revision = git(self.repo, "rev-parse", "--verify", f"{revision}^{{commit}}")
        git(self.repo, "config", "user.name", "cement seed")
        git(self.repo, "config", "user.email", "seed@example.invalid")
        common = Path(git(ROOT, "rev-parse", "--path-format=absolute", "--git-common-dir"))
        old = common / "cement-d28-verdicts"
        if old.is_dir():
            shutil.copytree(old, self.repo / old.name)
        self.results = {}
        self.setup_failures = []
        self.neutral = False
        self.counter = 0
        self.lines = {}
        record = git(self.repo, "show", f"{self.revision}:{RULE}").splitlines()
        bullets = [(n, line) for n, line in enumerate(record, 1) if line.startswith("- ")]
        if len(bullets) != len(GROUPS):
            raise RuntimeError(f"seed coverage: {len(bullets)} bullets, {len(GROUPS)} groups")
        for sid, anchor, _, _ in GROUPS:
            hits = [n for n, line in bullets if line.startswith("- " + anchor)]
            if len(hits) != 1:
                raise RuntimeError(f"{sid} record anchor has {len(hits)} matches")
            self.lines[sid] = hits[0]

    @contextlib.contextmanager
    def tree(self, revision=None):
        self.counter += 1
        root = self.temp / f"tree-{self.counter}"
        base = git(self.repo, "rev-parse", "--verify", f"{revision or self.revision}^{{commit}}")
        git(self.repo, "worktree", "add", "--detach", str(root), base)
        before = tracked_digest(root)
        try:
            if self.neutral and (root / ".agent/skip-census").is_file():
                path = root / ".agent/skip-census"
                text = replace(path.read_text(),
                               "if unlisted or missing or len(found) != len(set(found)):",
                               "if False:  # p77 neutralized verdict")
                with changed(path, text):
                    yield root
            else:
                yield root
        finally:
            git(root, "reset", "--hard", base)
            after = tracked_digest(root)
            if before != after:
                raise RuntimeError(f"RESTORE-DIFF tree {root}")
            git(root, "diff", "--quiet")
            git(root, "diff", "--cached", "--quiet")
            print(f"TREE-RESTORED {root.name} {len(before)} files sha256-equal git-diff=0", flush=True)
            git(self.repo, "worktree", "remove", "--force", str(root))

    def case(self, sid, name, root, argv, rc, tokens=(), *, env=None, timeout=None):
        actual, output, seconds = run(argv, root, env=env, timeout=timeout)
        return self.observe(sid, name, actual, output, rc, tokens, seconds=seconds)

    def observe(self, sid, name, actual, output, rc, tokens=(), *, seconds=0):
        matches = [re.search(token, output, re.MULTILINE) for token in tokens]
        passed = actual == rc and all(matches)
        observed = [match.group(0).replace("\n", " ") if match else "ABSENT" for match in matches]
        key = f"{sid}.{name}"
        self.results[key] = passed
        print(f"{key} {RULE}:{self.lines[sid]} expected rc={rc} token={json.dumps(tokens)} "
              f"observed rc={actual} token={json.dumps(observed)} "
              f"{'MATCH' if passed else 'DIFF'} {seconds:.1f}s", flush=True)
        if not passed:
            print(output[-5000:], flush=True)
        return actual, output

    def python(self, sid, name, root, path, rc, tokens=(), **kwargs):
        return self.case(sid, name, root, [sys.executable, path], rc, tokens, **kwargs)

    def suite(self, sid, name, root, tests, rc, tokens=(), **kwargs):
        return self.case(sid, name, root, [sys.executable, "-m", "unittest", *tests], rc, tokens, **kwargs)

    def execute(self, selected):
        self.results = {}
        for sid, _, name, _ in GROUPS:
            if sid not in selected:
                continue
            start = time.monotonic()
            print(f"BEGIN {sid} {name} neutralized={self.neutral}", flush=True)
            try:
                getattr(self, sid)()
            except Exception as exc:
                self.setup_failures.append(sid)
                self.observe(sid, "setup", 2, f"SETUP {type(exc).__name__}: {exc}", 0, ["ready"])
            verdicts = [value for key, value in self.results.items() if key.startswith(sid + ".")]
            print(f"{sid} {RULE}:{self.lines[sid]} {sum(verdicts)}/{len(verdicts)} "
                  f"{'MATCH' if verdicts and all(verdicts) else 'DIFF'} "
                  f"{time.monotonic() - start:.1f}s", flush=True)
        return dict(self.results)

