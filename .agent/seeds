            self.observe(sid, "survivors-rise", 0, f"survivors={counts}; rise={len(counts) == 2 and counts[1] > counts[0]}",
                         0, ["rise=True"])


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--rev", default="HEAD")
    parser.add_argument("--only", nargs="+", choices=[row[0] for row in GROUPS])
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--self-test", action="store_true", help="repeat every selected seed with S12 neutralized")
    args = parser.parse_args()
    if args.list:
        for sid, _, name, slow in GROUPS:
            print(f"{sid} {'slow' if slow else 'fast'} {name}")
        return 0
    selected = set(args.only or [row[0] for row in GROUPS])
    if args.self_test and "S12" not in selected:
        parser.error("--self-test requires S12 in the selected set")
    with tempfile.TemporaryDirectory(prefix="cement-seeds-") as directory:
        runner = Runner(args.rev, directory)
        print(f"REV {runner.revision} isolated mirror; selected={','.join(sorted(selected))}", flush=True)
        baseline = runner.execute(selected)
        if args.self_test:
            runner.neutral = True
            altered = runner.execute(selected)
            flips = sorted(key for key in baseline.keys() | altered.keys() if baseline.get(key) != altered.get(key))
            expected = [f"S12.{name}" for name in ("alias", "flat", "nested", "reimport")]
            matched = flips == expected and all(baseline.values())
            print(f"N1 expected={expected} observed={flips} {'MATCH' if matched else 'DIFF'}", flush=True)
            return 2 if runner.setup_failures else (0 if matched else 1)
        return 2 if runner.setup_failures else (0 if baseline and all(baseline.values()) else 1)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
        print(f"seeds: SETUP/RESTORE FAILURE: {exc}", file=sys.stderr)
        raise SystemExit(2)
